{
  "name": "vigor",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@invertase/react-native-apple-authentication": "^2.5.1",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/auth": "^26.4.0",
    "@react-native-firebase/firestore": "^26.4.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "expo": "~57.0.24",
    "expo-apple-authentication": "~57.0.2",
    "expo-build-properties": "~57.0.21",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-glass-effect": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "i18next": "^26.4.2",
    "react": "19.2.3",
    "react-i18next": "^17.0.15",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "metro": "0.84.5",
    "metro-config": "0.84.5",
    "metro-resolver": "0.84.5",
    "metro-transform-worker": "0.84.5",
    "metro-babel-transformer": "0.84.5",
    "metro-runtime": "0.84.5",
    "metro-cache": "0.84.5",
    "metro-source-map": "0.84.5"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "volume": "tsx scripts/volume-harness.ts",
    "catalogue": "tsx scripts/catalogue-report.ts"
  },
  "jest": {
    "preset": "jest-expo",
    "collectCoverageFrom": [
      "src/services/analytics/**/*.ts",
      "src/services/training/**/*.ts",
      "src/services/repositories/BaseRepository.ts",
      "src/i18n/units.ts",
      "src/i18n/resolveLanguage.ts",
      "src/components/train/rirColor.ts",
      "src/components/train/setTypeLabel.ts",
      "!src/**/*.d.ts",
      "!src/**/__tests__/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  },
  "private": true
}
